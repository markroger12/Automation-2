# Blog Automation Studio — example configuration (no secrets here).
# `npm run setup` creates .env from this file if .env is missing.
# It never overwrites an existing .env.
#
# There is no login: this is a private single-owner tool. The dashboard listens
# only on 127.0.0.1 so other computers on your network cannot open it, and every
# state-changing request needs a same-origin CSRF token.

# SQLite database (relative to prisma/schema.prisma). Resolved to an absolute
# path at runtime by src/lib/paths.ts so Windows drive letters/spaces work.
DATABASE_URL="file:../data/app.db"

# Dashboard origin used for same-origin/CSRF checks and the extension agent.
APP_ORIGIN="http://localhost:3000"

# Browser for WordPress automation and previews: chrome (default) | msedge | chromium
BROWSER_CHANNEL="chrome"
# Optional explicit executable (e.g. C:\Program Files\Google\Chrome\Application\chrome.exe)
BROWSER_EXECUTABLE_PATH=""

# Optional licensed search API for the Plagiarism Evidence Checker (https://serper.dev).
SERPER_API_KEY=""

# Disposable WordPress used ONLY by `npm run test:integration` end-to-end tests.
WP_E2E_ADMIN_URL=""
