// Blog Automation Studio 3.0 — SQLite schema.
//
// Conventions
// - Status/enum-like columns are plain strings validated by the shared Zod
//   schemas in src/lib/domain.ts (SQLite has no native enums and string columns
//   keep future migrations additive).
// - JSON columns are TEXT holding JSON validated by Zod on read/write
//   (src/lib/json.ts). Never store fabricated aggregates in them.
// - Never reset this database during setup or upgrades: use additive
//   migrations only (npm run db:migrate runs `prisma migrate deploy`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BrowserProfile {
  id            String    @id @default(cuid())
  name          String
  kind          String // CHATGPT | WORDPRESS | GENERIC
  profileDir    String    @unique // relative to data/, validated slug path
  sessionState  String    @default("UNKNOWN") // UNKNOWN | ACTIVE | LOGIN_REQUIRED | ERROR
  lastCheckedAt DateTime?
  lastLoginAt   DateTime?
  diagnostics   String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  websites      Website[]
}

model Website {
  id                       String                  @id @default(cuid())
  name                     String
  slug                     String                  @unique
  publicUrl                String
  adminUrl                 String
  active                   Boolean                 @default(true)
  paused                   Boolean                 @default(false)
  wordpressProfileId       String?
  wordpressProfile         BrowserProfile?         @relation(fields: [wordpressProfileId], references: [id], onDelete: SetNull)
  defaultCategoryId        String?
  editorType               String                  @default("AUTO") // AUTO | GUTENBERG | CLASSIC
  detectedEditor           String?
  language                 String                  @default("en") // en | de
  targetCountry            String                  @default("United States")
  timezone                 String                  @default("UTC")
  internalLinkLine         String                  @default("Also read:")
  logoPath                 String?
  imageSettings            String                  @default("{}")
  imageTemplate            String                  @default("{}")
  canPublish               Boolean                 @default(false)
  canPublishAcknowledgedAt DateTime?
  allowLiveUpdates         Boolean                 @default(false)
  searchConsoleProperty    String?
  settingsOverrides        String                  @default("{}")
  /// Per-site writer routing rules: [{ contains, writer }] checked before the classifier (upgrade 05).
  routingRules             String                  @default("[]")
  promptOverrides          String                  @default("{}")
  linkStrategy             String                  @default("{}")
  queueQuota               Int                     @default(0)
  priority                 Int                     @default(0)
  rankMathTarget           Int?
  notes                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  categories               Category[]
  tasks                    ArticleTask[]
  workflows                Workflow[]
  mediaAssets              MediaAsset[]
  linkTargets              LinkTarget[]
  linkIndexSyncedAt        DateTime?
  linkIndexFullSyncAt      DateTime?
  campaigns                Campaign[]
  healthObservations       SiteHealthObservation[]
}

model Category {
  id               String   @id @default(cuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  externalId       Int
  name             String
  slug             String?
  parentExternalId Int?
  postCount        Int?
  syncedAt         DateTime @default(now())

  @@unique([websiteId, externalId])
  @@index([websiteId, name])
}

model ArticleTask {
  id                 String                  @id @default(cuid())
  moduleKey          String
  websiteId          String
  website            Website                 @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  categoryId         String?
  categoryName       String?
  categoryExternalId Int?
  keyword            String
  normalizedKeyword  String
  exampleTitle       String?
  secondaryKeywords  String                  @default("[]")
  targetCountry      String
  language           String
  status             String                  @default("QUEUED")
  stage              String?
  percent            Int                     @default(0)
  message            String?
  errors             String                  @default("[]")
  reviewReasons      String                  @default("[]")
  nextAction         String?
  pausedFor          String? // chatgpt-login | chatgpt-human-check | wordpress-login | usage-limit
  cancelRequested    Boolean                 @default(false)
  options            String                  @default("{}")
  configSnapshot     String                  @default("{}")
  titleOptions       String                  @default("[]")
  recommendedTitle   String?
  selectedTitle      String?
  titleApprovedAt    DateTime?
  articleApprovedAt  DateTime?
  researchNotes      String?
  outputs            String                  @default("{}")
  bodyHtml           String?
  editedHtml         String?
  editedAt           DateTime?
  assembledHtml      String?
  faqs               String                  @default("[]")
  quickBio           String                  @default("[]")
  quickBioHtml       String?
  tags               String                  @default("[]")
  seoTitle           String?
  metaDescription    String?
  slug               String?
  focusKeyword       String?
  metrics            String                  @default("{}")
  seoScore           Int?
  rankMathScore      Int?
  rankMathVerifiedAt DateTime?
  conversationUrl    String?
  wpPostId           Int?
  wpEditUrl          String?
  wpPostStatus       String?
  wpDraftAt          DateTime?
  wpModifiedGmt      String?
  wpCreateMarker     String?
  wpContentHash      String? // sha256 of the content WordPress stored at the app's last verified save
  wpSlug             String?
  wpVerifiedAt       DateTime? // last full read-back verification (VERIFIED_COMPLETE)
  rankMathReport     String? // JSON: fields, score, recommendations, correction rounds (read from WordPress, never computed)
  verifiedCompleteAt DateTime?
  idempotencyKey     String                  @unique
  version            Int                     @default(0)
  priority           Int                     @default(0)
  source             String                  @default("SINGLE") // SINGLE | BULK | WORKFLOW | BENCHMARK | REFRESH
  campaignId         String?
  campaignRowId      String?
  workflowKeywordId  String?
  benchmarkRunId     String?
  routeDecision      String                  @default("{}")
  legacy             Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  stages             ArticleStage[]
  responses          ChatGPTResponse[]
  humanizerRuns      HumanizerRun[]
  plagiarismChecks   PlagiarismCheck[]
  seoReports         SEOReport[]
  fingerprints       ContentFingerprint[]
  claims             ClaimEvidence[]
  linkSuggestions    SuggestedInternalLink[]
  duplicateMatches   DuplicateMatch[]
  qualityReports     ArticleQualityReport[]
  mediaAssets        MediaAsset[]

  @@index([status])
  @@index([websiteId, status])
  @@index([createdAt])
  @@index([normalizedKeyword])
  @@index([moduleKey])
  @@index([verifiedCompleteAt])
}

model ArticleStage {
  id            String                 @id @default(cuid())
  taskId        String
  task          ArticleTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  key           String
  position      Int
  label         String
  kind          String // chatgpt | local | gate | wordpress
  status        String                 @default("PENDING") // PENDING | RUNNING | WAITING | COMPLETED | FAILED | SKIPPED
  attempts      Int                    @default(0)
  inputSnapshot String?
  promptVersion String?
  prompt        String?
  output        String?
  outputHtml    String?
  outputJson    String?
  error         String?
  message       String?
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  privateState  String                 @default("{}")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  revisions     ArticleStageRevision[]

  @@unique([taskId, key])
  @@index([status])
}

model ArticleStageRevision {
  id         String       @id @default(cuid())
  stageId    String
  stage      ArticleStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  taskId     String
  key        String
  reason     String
  prompt     String?
  output     String?
  outputHtml String?
  outputJson String?
  createdAt  DateTime     @default(now())

  @@index([taskId, key])
}

model ChatGPTResponse {
  id                  String        @id @default(cuid())
  /// The article this prompt belongs to; null for standalone Humanizer runs (see runId).
  taskId              String?
  task                ArticleTask?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runId               String?
  run                 HumanizerRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  stageKey            String
  attempt             Int
  jobId               String?
  operationId         String        @unique
  promptHash          String
  renderedPrompt      String
  resultText          String?
  resultHtml          String?
  conversationUrl     String?
  responseFingerprint String?
  recovered           Boolean       @default(false)
  reused              Boolean       @default(false)
  conversationSwitch  Boolean       @default(false)
  elapsedMs           Int?
  status              String        @default("PENDING") // PENDING | COMPLETED | FAILED | SUPERSEDED
  error               String?
  createdAt           DateTime      @default(now())
  completedAt         DateTime?

  @@index([taskId, stageKey])
  @@index([runId])
}

/// A Humanizer page run: a saved article or pasted text, edited paragraph by paragraph with fact locks.
model HumanizerRun {
  id             String            @id @default(cuid())
  taskId         String?
  task           ArticleTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  source         String // ARTICLE | PASTE
  title          String
  language       String
  keyword        String            @default("")
  scope          String            @default("all") // all | flagged
  promptOverride String?
  inputHtml      String
  /// Hash of the article content the run started from (ARTICLE runs): applying is refused if the article changed since.
  baselineHash   String?
  status         String            @default("QUEUED") // QUEUED | WAITING | COMPLETED | FAILED | CANCELLED
  message        String?
  result         String            @default("{}")
  outputHtml     String?
  appliedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  responses      ChatGPTResponse[]

  @@index([taskId])
  @@index([createdAt])
}

/// Plagiarism Evidence Checker run: evidence (matching passages + sources) and coverage, never a verdict.
model PlagiarismCheck {
  id         String       @id @default(cuid())
  taskId     String?
  task       ArticleTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  source     String // ARTICLE | PASTE
  title      String
  language   String
  keyword    String       @default("")
  inputHtml  String
  /// { ownerArticles, linkedPages, wikipedia, search, urls: string[] }
  options    String       @default("{}")
  status     String       @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  message    String?
  progress   String?
  result     String       @default("{}")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([taskId])
  @@index([createdAt])
}

/// Normalized paragraph hashes of an article (upgrade 07): fast exact-paragraph lookups across websites.
model ContentFingerprint {
  id        String      @id @default(cuid())
  taskId    String
  task      ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  websiteId String
  kind      String      @default("PARAGRAPH")
  hash      String
  words     Int
  position  Int
  createdAt DateTime    @default(now())

  @@index([hash])
  @@index([taskId])
}

/// Wording overlap between an article and another saved article, with evidence (never a verdict).
model DuplicateMatch {
  id              String      @id @default(cuid())
  taskId          String
  task            ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  otherTaskId     String
  otherTitle      String
  otherWebsite    String
  sameWebsite     Boolean
  severity        String // HIGH | MEDIUM | LOW
  wordingWords    Int
  factWords       Int
  longestRun      Int
  nearSentences   Int
  exactParagraphs Int
  wordingShare    Float
  excerpts        String      @default("[]")
  status          String      @default("OPEN") // OPEN | OVERRIDDEN | CLEARED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([taskId])
  @@index([status, severity])
}

/// One quality evaluation of an article (upgrade 12): hard stops, warnings and the evidence per area.
model ArticleQualityReport {
  id        String      @id @default(cuid())
  taskId    String
  task      ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stage     String // QUALITY_GATE | VERIFIED_COMPLETE
  status    String // PASS | REVIEW | BLOCKED
  hardStops String      @default("[]")
  warnings  String      @default("[]")
  sections  String      @default("{}")
  createdAt DateTime    @default(now())

  @@index([taskId, createdAt])
}

/// One fetched source page (upgrade 03), cached per URL; reused across articles for 7 days.
model SourceRecord {
  id          String   @id @default(cuid())
  url         String   @unique
  host        String
  title       String   @default("")
  status      String // OK | DEAD | BLOCKED | NOT_HTML | FAILED
  httpStatus  Int?
  detail      String?
  /// Readable text of the page (bounded), kept so claims can be re-checked without fetching again.
  text        String   @default("")
  contentHash String?
  fetchedAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([host])
}

/// One significant claim from an article's research and the evidence for it (upgrade 03).
model ClaimEvidence {
  id               String      @id @default(cuid())
  taskId           String
  task             ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  claimType        String // BIRTH | DEATH | FAMILY | EDUCATION | AWARD | NET_WORTH | CAREER
  claimText        String
  values           String      @default("{}")
  nature           String // REPORTED_FACT | ESTIMATE | UNVERIFIED_CLAIM
  highImpact       Boolean     @default(false)
  status           String // VERIFIED | SINGLE_SOURCE | ESTIMATE | DISPUTED | CONTRADICTED | UNVERIFIED
  citations        String      @default("[]")
  /// [{ sourceId, url, host, verdict, excerpt, detail, observedAt }]
  evidence         String      @default("[]")
  articleParagraph Int?
  ownerDecision    String? // ACCEPTED | OMIT | CORRECTED
  ownerValue       String?
  ownerNote        String?
  decidedAt        DateTime?
  researchedAt     DateTime
  createdAt        DateTime    @default(now())

  @@index([taskId])
  @@index([status])
}

/// What the internal-link stage considered for an article (upgrade 06), and why each target was or was not used.
model SuggestedInternalLink {
  id        String      @id @default(cuid())
  taskId    String
  task      ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  websiteId String
  targetId  String?
  url       String
  title     String
  kind      String // LINE | CONTEXTUAL | CANDIDATE
  anchor    String?
  score     Float
  reasons   String      @default("[]")
  status    String // SELECTED | PROPOSED | NO_ANCHOR | UNREACHABLE | NOT_RELATED
  note      String?
  createdAt DateTime    @default(now())

  @@index([taskId])
}

model PromptTemplate {
  id             String                  @id @default(cuid())
  moduleKey      String
  stageKey       String
  name           String
  description    String
  content        String
  defaultHash    String
  defaultVersion Int
  version        Int                     @default(1)
  variables      String                  @default("[]")
  customized     Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  versions       PromptTemplateVersion[]

  @@unique([moduleKey, stageKey])
}

model PromptTemplateVersion {
  id         String         @id @default(cuid())
  templateId String
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  content    String
  note       String?
  createdAt  DateTime       @default(now())

  @@unique([templateId, version])
}

model QueueJob {
  id              String    @id @default(cuid())
  queue           String // article | chatgpt | control | workflow | humanizer | maintenance
  kind            String
  taskId          String?
  relatedId       String?
  websiteId       String?
  payload         String    @default("{}")
  result          String?
  status          String    @default("WAITING") // WAITING | ACTIVE | COMPLETED | FAILED | CANCELLED
  priority        Int       @default(0)
  runAt           DateTime  @default(now())
  leaseUntil      DateTime?
  lockedBy        String?
  heartbeatAt     DateTime?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  retryPlan       String    @default("{}")
  idempotencyKey  String    @unique
  error           String?
  errorCode       String?
  claimedByTab    String?
  conversationUrl String?
  progress        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([queue, status, runAt])
  @@index([taskId])
  @@index([status, leaseUntil])
}

model WorkerStatus {
  id           String    @id // "worker" or "extension:<installId>"
  kind         String // WORKER | EXTENSION
  version      String?
  capabilities String    @default("{}")
  status       String
  diagnostics  String    @default("{}")
  pid          Int?
  startedAt    DateTime?
  lastSeenAt   DateTime
}

model Log {
  id             String   @id @default(cuid())
  level          String // debug | info | warn | error
  category       String
  stage          String?
  taskId         String?
  jobId          String?
  message        String
  details        String?
  screenshotPath String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([taskId])
  @@index([level, createdAt])
}

model Setting {
  key           String   @id
  value         String
  schemaVersion Int      @default(1)
  updatedAt     DateTime @updatedAt
}

model SEOReport {
  id        String      @id @default(cuid())
  taskId    String
  task      ArticleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  source    String // INTERNAL | RANKMATH
  score     Int?
  checks    String      @default("[]")
  metrics   String      @default("{}")
  createdAt DateTime    @default(now())

  @@index([taskId, source])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// A bulk campaign: one import of up to 1,000 keyword rows. The original input text is kept as entered.
model Campaign {
  id            String        @id @default(cuid())
  name          String
  websiteId     String
  website       Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  defaultWriter String        @default("AUTO") // AUTO | celebrity-writer | tigram-writer
  options       String        @default("{}") // task options applied to every row
  inputText     String
  format        String
  routerVersion String
  status        String        @default("QUEUEING") // QUEUEING | ACTIVE | PAUSED | COMPLETED | CANCELLED
  message       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rows          CampaignRow[]

  @@index([createdAt])
}

/// One imported row. `raw` is the original line/record; everything else is derived and may be corrected by the owner.
model CampaignRow {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  position          Int
  line              Int
  raw               String
  keyword           String
  normalizedKeyword String
  secondaryKeywords String   @default("[]")
  exampleTitle      String?
  websiteId         String?
  categoryId        String?
  language          String?
  priority          Int      @default(0)
  notes             String?
  writer            String? // celebrity-writer | tigram-writer | null (owner must choose)
  writerSource      String? // RULE | OVERRIDE | CAMPAIGN
  routerConfidence  Float?
  routerRationale   String?
  /// READY | NEEDS_WRITER | NEEDS_CATEGORY | DUPLICATE | INVALID | SKIPPED | QUEUED | CANCELLED
  status            String
  issues            String   @default("[]")
  confirmedVariant  Boolean  @default(false)
  taskId            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([campaignId, position])
  @@index([campaignId, status])
}

model Workflow {
  id                    String            @id @default(cuid())
  websiteId             String
  website               Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name                  String
  active                Boolean           @default(false)
  writerPreference      String            @default("AUTO") // AUTO | celebrity-writer | tigram-writer
  weekdays              String            @default("[]") // [] = every day; 0=Sunday
  slots                 String            @default("[]") // ["9:00 AM", ...] Asia/Karachi
  slotTimezone          String            @default("Asia/Karachi")
  writeAheadHours       Int               @default(24)
  maxBacklog            Int               @default(10)
  imagesOverride        String            @default("inherit") // inherit | on | off
  requestIndexing       Boolean           @default(false)
  // Search Console property: "https://example.com/" (URL prefix) or "sc-domain:example.com"; null = the website URL.
  searchConsoleProperty String?
  maxRetries            Int               @default(3)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  keywords              WorkflowKeyword[]
}

model WorkflowKeyword {
  id                  String    @id @default(cuid())
  workflowId          String
  workflow            Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  keyword             String
  normalizedKeyword   String
  exampleTitle        String?
  secondaryKeywords   String    @default("[]")
  writerType          String    @default("UNKNOWN") // UNKNOWN | CELEBRITY | TIGRAM
  detectionReason     String?
  detectionSource     String? // RULE | OVERRIDE | IMPORT
  detectionConfidence Float?
  position            Int
  status              String    @default("WAITING") // WAITING | WRITING | READY | SCHEDULED | PUBLISHED | INDEXING_REQUESTED | INDEXED | FAILED | SKIPPED | DONE
  taskId              String?
  scheduledAt         DateTime?
  publishedUrl        String?
  publishedAt         DateTime?
  indexingRequestedAt DateTime?
  indexingStatus      String?
  retries             Int       @default(0)
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workflowId, status, position])
}

model SlotReservation {
  id                String   @id @default(cuid())
  websiteId         String
  scheduledAt       DateTime
  workflowKeywordId String   @unique
  createdAt         DateTime @default(now())

  @@unique([websiteId, scheduledAt])
}

model MediaAsset {
  id              String       @id @default(cuid())
  taskId          String?
  task            ArticleTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  websiteId       String?
  website         Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  role            String // FEATURED | BODY1 | BODY2 | GALLERY | UPLOAD (owner photo for a task) | LOGO | TEMPLATE_PHOTO (site template library)
  responseId      String? // ChatGPTResponse that produced this image (generated images)
  origin          String // GENERATED | UPLOADED | WIKIMEDIA | CHATGPT | RENDERED
  sourceUrl       String?
  filePath        String
  sha256          String
  phash           String?
  width           Int?
  height          Int?
  bytes           Int?
  mime            String?
  altText         String?
  wpMediaId       Int?
  wpUrl           String?
  /// Set before a Media Library upload starts and cleared when its answer arrives. Still set on a retry =
  /// the earlier upload may have reached WordPress; it is looked up by its unique slug before uploading again.
  uploadStartedAt DateTime?
  status          String       @default("READY") // READY | UPLOADED | REJECTED | FAILED
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([taskId, role])
  @@index([sha256])
  @@index([responseId])
}

/// Per-site WordPress health evidence (upgrade 09): measured results of session tests, REST reachability,
/// account permissions, editor detection, draft saves and media uploads. Nothing is estimated.
model SiteHealthObservation {
  id         String   @id @default(cuid())
  websiteId  String
  website    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  kind       String // SESSION | REST | PERMISSIONS | EDITOR | RANK_MATH | DRAFT_SAVE | MEDIA_UPLOAD
  status     String // OK | WARN | FAIL
  message    String
  durationMs Int?
  taskId     String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([websiteId, kind, createdAt])
  @@index([websiteId, createdAt])
}

model DataMigration {
  id        String   @id
  appliedAt DateTime @default(now())
  details   String   @default("{}")
}

/// Measured timing/outcome evidence. Unique keys prevent double counting on retries.
model ProductionMetric {
  id         String   @id @default(cuid())
  kind       String // STAGE | CHATGPT | WORDPRESS | IMAGE | BACKOFF | ARTICLE_VERIFIED | QUEUE_WAIT
  taskId     String?
  stageKey   String?
  moduleKey  String?
  websiteId  String?
  attempt    Int      @default(1)
  outcome    String // COMPLETED | FAILED | SKIPPED | PAUSED | WAITING
  startedAt  DateTime
  endedAt    DateTime
  durationMs Int
  waitMs     Int      @default(0)
  details    String   @default("{}")
  dedupeKey  String   @unique
  createdAt  DateTime @default(now())

  @@index([kind, endedAt])
  @@index([taskId])
  @@index([websiteId, kind, endedAt])
}

/// Stalled jobs and uncertain external side effects found by recovery.
model RecoveryIncident {
  id          String    @id @default(cuid())
  kind        String // EXPIRED_LEASE | UNCERTAIN_PROMPT | UNCERTAIN_WP_CREATE | UNCERTAIN_MEDIA | UNCERTAIN_SCHEDULE | STALLED
  severity    String    @default("warning") // info | warning | critical
  status      String    @default("OPEN") // OPEN | AUTO_RESOLVED | RESOLVED | DISMISSED
  jobId       String?
  taskId      String?
  stageKey    String?
  description String
  evidence    String    @default("{}")
  resolution  String?
  dedupeKey   String    @unique
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([taskId])
}

/**
 * Per-website internal link index: published posts that may be linked from new articles.
 */
model LinkTarget {
  id            String    @id @default(cuid())
  websiteId     String
  website       Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  wpPostId      Int
  url           String
  title         String
  slug          String?
  categoryIds   String    @default("[]") // WordPress category IDs (JSON)
  keyword       String? // primary keyword when the post came from this app
  excerpt       String?
  publishedAt   DateTime?
  modifiedAt    DateTime?
  status        String    @default("ACTIVE") // ACTIVE | BROKEN | REMOVED
  lastCheckedAt DateTime?
  checkNote     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([websiteId, wpPostId])
  @@index([websiteId, status])
}
